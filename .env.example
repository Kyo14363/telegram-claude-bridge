# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_USER_IDS=123456789

# Optional Claude / SDK settings
# CLAUDE_CLI_PATH=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
# WORKING_DIR=%USERPROFILE%\claude-workspace
# SDK_PERMISSION_MODE=bypassPermissions
# SDK_SETTING_SOURCES=user,project,local
# SDK_SKILLS=all
# SDK_PROGRESS_EDIT_INTERVAL=1.5
# TIMEOUT=600
# MAX_HISTORY_ROUNDS=10
# LOG_RETENTION_DAYS=14

# Optional Gemini features (image understanding via Gemini Vision)
# GOOGLE_API_KEY=your_google_api_key_here
# IMAGE_ANALYSIS_ENABLED=true
# MAX_IMAGES_PER_MESSAGE=5
# IMAGE_ANALYSIS_TIMEOUT=30

# Optional storage paths (defaults: relative to bridge directory)
# OBSIDIAN_MOBILE_DIR=.\obsidian_clippings
# FETCH_OUTPUT_DIR=.\fetch_outputs
# LOG_DIR=.\logs
# HISTORY_FILE=.\conversation_history.json
# SESSION_STATE_FILE=.\session_state.json

# Optional URL / browser behavior
# URL_FETCH_TIMEOUT=15
# THIN_CONTENT_THRESHOLD=200
# BROWSER_IDLE_CLOSE_MIN=5
# BROWSER_IDLE_CHECK_SEC=60
# TG_MAX_PHOTO_BYTES=10485760

# Optional reply triggers, comma-separated
# REPLY_KEYWORDS=capture replies,fetch replies,收錄留言,抓回覆,看留言

# Optional twikit reply capture (X/Twitter). Path to a Chrome cookies JSON.
# When unset, the bridge falls back to Playwright-based reply capture.
# REPLY_MAX_FETCH=80
# TWIKIT_COOKIES=C:\path\to\cookies.json
